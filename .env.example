# Copy to .env and fill in. Never commit .env.
# Local development values only; production secrets live on the server and in GitHub environments.

POSTGRES_DB=meuquarto
POSTGRES_USER=meuquarto
# Use a random value, e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=

# Set to true ONLY in production behind Caddy, which overwrites X-Forwarded-For (ADR 0017).
# Leave false when the web port can be reached directly: clients could pick their own IP.
TRUST_PROXY_HEADERS=false

# TMDB "API Read Access Token" (themoviedb.org > Settings > API). Without it, film and series search
# reports itself unavailable. Server-side only; never sent to the browser.
TMDB_API_KEY=

# Public origin of the site, used for absolute URLs in page metadata (Open Graph). Not a secret.
# Defaults to https://meuquarto.com.br; set http://localhost:3000 for local runs if you want local previews.
SITE_URL=

# Outgoing e-mail (password reset). Locally the compose stack uses Mailpit (MAIL_* unset is fine):
# read the e-mails at http://localhost:8025. In production point these at a transactional provider's
# SMTP (ADR 0012), e.g. port 587 with MAIL_AUTH=true and MAIL_STARTTLS=true (or port 465 with MAIL_SSL=true).
# MAIL_FROM must be an address on the domain that has SPF, DKIM and DMARC set up. The links in the
# e-mails use SITE_URL above (an https origin in production; http is accepted only for localhost).
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=
MAIL_STARTTLS=
MAIL_SSL=
